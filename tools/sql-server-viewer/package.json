{
  "name": "sql-server-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check:sql": "tsx src/server/checkSqlConnection.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@fastify/cors": "^10.0.1",
    "@mui/material": "^6.1.6",
    "@mui/x-data-grid": "^7.22.2",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "lucide-react": "^0.468.0",
    "mssql": "^11.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^8.3.0"
  }
}
