SQLSV_DEMO_MODE=true
# Select sqlserver or mysql. Keep demo mode true until the matching connection is configured.
SQLSV_DB_CLIENT=sqlserver
SQLSV_HOST=localhost
SQLSV_PORT=1433
SQLSV_USER=readonly_user
SQLSV_PASSWORD=
SQLSV_ENCRYPT=true
SQLSV_TRUST_SERVER_CERTIFICATE=true
SQLSV_DATABASE_ALLOWLIST=
SQLSV_TABLE_ALLOWLIST=
SQLSV_DEFAULT_PAGE_SIZE=100
SQLSV_MAX_PAGE_SIZE=500
SQLSV_API_PORT=3001
SQLSV_WEB_PORT=5173

# MySQL configuration (used only when SQLSV_DB_CLIENT=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=readonly_user
MYSQL_PASSWORD=
MYSQL_DATABASE_ALLOWLIST=
MYSQL_TABLE_ALLOWLIST=
